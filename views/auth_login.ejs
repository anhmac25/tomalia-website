<div class="section">
  <div class="h1">Log in</div>
  <div class="muted">Travelers can log in using email or username.</div>
  <% if (error) { %><div class="toast"><%= error %></div><% } %>
</div>

<div class="panel">
  <form class="form" method="POST" action="/login">
    <input type="hidden" name="next" value="<%= next %>"/>
    <div>
      <label>Email or Username</label>
      <input name="identifier" placeholder="eg. tomalian@tml.vn or tomalian" required />
    </div>
    <div>
      <label>Password</label>
      <input name="password" type="password" required/>
    </div>
    <button class="btn primary" type="submit">Log in</button>
    <div class="small muted"> Forgot username or password? Click <b>here</b> if you need help! </div>
  </form>
</div>
